#!/bin/bash

# omarchy:summary=Record dictation using Whispy
# omarchy:args=<start|stop|toggle|trigger <preset>|shortcuts>

# Omarchy dictation backend for Whispy. `omarchy-dictation` runs it from the
# Hyprland dictation keys (held: start, released: stop; toggle keys: toggle);
# select it once with `omarchy-dictation-use whispy`. Whispy itself types the
# transcript (wtype).
#
# `trigger <preset>` is called by the Whispy bar panel: it saves the preset in
# Whispy's config and writes the Hyprland binding for it into
# ~/.config/whispy/shortcuts.lua, which Omarchy loads after its own default
# dictation keys whenever Whispy is the selected backend.

api="${WHISPY_API_URL:-http://127.0.0.1:9090}"
token_file="$HOME/.config/whispy/config.token"
shortcuts_file="${XDG_CONFIG_HOME:-$HOME/.config}/whispy/shortcuts.lua"

# The order the bar panel lists them in; must match OMARCHY_TRIGGER_PRESETS in
# src/whispy/core/config.py (a test checks it).
presets=(right_option_hold right_ctrl_hold f9_hold left_option_space_toggle)

# Tell the bar widget something changed, so its icon follows without polling.
# Best effort and in the background: a dictation never waits for the bar.
tell_bar() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell -q whispy "$1" >/dev/null 2>&1 &
}

# A failed call must never be silent: the user is holding a key and talking.
fail() {
  echo "omarchy-dictation-whispy: $1" >&2
  notify-send --app-name=Whispy --urgency=critical \
    --hint=string:x-canonical-private-synchronous:whispy \
    "Whispy ne répond pas" "$1" 2>/dev/null
  tell_bar refresh
  exit 1
}

# call METHOD PATH MAX_TIME [JSON_BODY]
call() {
  local method=$1 path=$2 max_time=$3 body=${4:-} token answer
  local args=(-fsS --max-time "$max_time" -X "$method")
  token=$(cat "$token_file" 2>/dev/null) || fail "no API token at $token_file — is Whispy installed?"
  [[ -n $body ]] && args+=(-H "Content-Type: application/json" --data "$body")
  if ! answer=$(curl "${args[@]}" -H "Authorization: Bearer $token" "$api$path" 2>&1); then
    fail "$method $path: ${answer:-no answer} — start it with: systemctl --user start whispy"
  fi
  printf '%s' "$answer"
}

start() {
  call POST /start 5 >/dev/null
  tell_bar refresh
}

# /stop answers once the transcript is ready and typed, and the API answers
# nothing else meanwhile, so the bar hears it is transcribing from here.
stop() {
  tell_bar transcribing
  call POST /stop 60 >/dev/null
  tell_bar refresh
}

hold_binding() {
  printf 'o.bind_hold("%s", "Start dictation (push-to-talk)", "omarchy-dictation start", "Stop dictation (push-to-talk)", "omarchy-dictation stop", { ignore_mods = true, non_consuming = true })\n' "$1"
}

# The Hyprland Lua for a preset. Hold keys are non-consuming, so Right Option
# still types AltGr characters (| [ ] { } ~ \) and Right Ctrl still works as Ctrl.
binding_for() {
  case "$1" in
    # French (Macintosh) and other AltGr layouts emit ISO_Level3_Shift; US emits Alt_R.
    right_option_hold) hold_binding ISO_Level3_Shift; hold_binding Alt_R ;;
    right_ctrl_hold) hold_binding Control_R ;;
    f9_hold) hold_binding F9 ;;
    left_option_space_toggle) echo 'o.bind("ALT + SPACE", "Toggle dictation", "omarchy-dictation toggle")' ;;
    *) return 1 ;;
  esac
}

write_shortcuts() {
  local preset=$1 binding tmp
  binding=$(binding_for "$preset")
  mkdir -p "$(dirname "$shortcuts_file")"
  tmp="$shortcuts_file.tmp"
  cat > "$tmp" << LUA
-- Generated by Whispy for the dictation key picked in its Omarchy bar panel
-- (omarchy-dictation-whispy trigger $preset). Rewritten on every pick.
-- Omarchy loads it after its default dictation keys while Whispy is the
-- dictation backend: it frees every preset key, then binds the chosen one.
for _, keys in ipairs({ "ALT + SPACE", "ALT + Alt_R", "Alt_R", "ISO_Level3_Shift", "Control_R", "F9" }) do
  hl.unbind(keys)
end
$binding
LUA
  mv "$tmp" "$shortcuts_file"
}

trigger() {
  local preset=${1:-} backend
  if ! binding_for "$preset" >/dev/null; then
    echo "omarchy-dictation-whispy: unknown trigger '${preset}', expected one of: ${presets[*]}" >&2
    exit 2
  fi
  # Saved first: with the daemon down, the key binding stays as it was.
  call POST /config 5 "{\"omarchy_trigger\": \"$preset\"}" >/dev/null
  write_shortcuts "$preset"
  if command -v hyprctl >/dev/null 2>&1 && ! hyprctl reload >/dev/null; then
    echo "omarchy-dictation-whispy: hyprctl reload failed; the new key applies at the next login" >&2
    exit 1
  fi
  backend=$(omarchy-default-dictation 2>/dev/null)
  if [[ -n $backend && $backend != whispy ]]; then
    echo "Warning: the dictation backend is $backend, so Omarchy ignores this key until: omarchy-dictation-use whispy" >&2
  fi
}

# The installer's path: write the binding file for the saved preset (or the
# default), without the daemon, so a fresh install binds the key the panel shows.
shortcuts() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/whispy/config.json" preset
  preset=$(sed -n 's/.*"omarchy_trigger": *"\([a-z0-9_]*\)".*/\1/p' "$config" 2>/dev/null | head -n 1)
  binding_for "$preset" >/dev/null || preset=${presets[0]}
  write_shortcuts "$preset"
  echo "$preset"
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle)
    status=$(call GET /status 2) || exit 1
    if [[ $status == *'"is_recording": true'* ]]; then
      stop
    else
      start
    fi
    ;;
  trigger) trigger "${2:-}" ;;
  shortcuts) shortcuts ;;
  *) echo "Usage: omarchy dictation whispy <start|stop|toggle|trigger <preset>|shortcuts>" >&2; exit 1 ;;
esac
